# =============================================================
# AgenticSQL — Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# Google AI Studio API Key (https://aistudio.google.com/)
GOOGLE_API_KEY="your_google_api_key_here"

# LLM Configuration
LLM_MODEL="gemini-2.5-flash"
LLM_TEMPERATURE=0

# Server Configuration (for --server mode)
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000


# =============================================================
# DATABASE CONFIGURATION OPTIONS
# Choose EITHER Option A (Direct URI) OR Option B (Discrete Fields)
# =============================================================

# -------------------------------------------------------------
# OPTION A: Direct Connection URI (Recommended for Cloud DBs)
# -------------------------------------------------------------
# If DATABASE_URL is set, it takes precedence over discrete DB_* fields below.
#
# Examples:
#   Supabase / Neon / RDS Postgres / Cloud SQL:
#     DATABASE_URL="postgresql://postgres:password@ep-cool-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
#   PlanetScale / RDS MySQL:
#     DATABASE_URL="mysql+pymysql://user:password@aws.connect.psdb.cloud/mydb?ssl_accept=strict"
#   CockroachDB:
#     DATABASE_URL="cockroachdb://user:password@free-tier.gcp-us-central1.cockroachlabs.cloud:26257/defaultdb?sslmode=require"
#   Azure SQL / MS SQL Server:
#     DATABASE_URL="mssql+pyodbc://user:password@myserver.database.windows.net/mydb?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes"
#   Local SQLite:
#     DATABASE_URL="sqlite:///mydb.sqlite"

# DATABASE_URL=""


# -------------------------------------------------------------
# OPTION B: Discrete Database Parameters
# -------------------------------------------------------------
# Database Type / Dialect: 'mssql', 'postgresql', 'mysql', 'sqlite', 'cockroachdb'
DB_TYPE="mssql"

# Server / Host (e.g. 127.0.0.1, db.xyz.supabase.co, myserver.database.windows.net)
DB_SERVER="127.0.0.1"

# Port (Optional — defaults to 5432 for Postgres, 3306 for MySQL, 1433 for MSSQL, 26257 for CockroachDB)
# DB_PORT=1433

# Database Name (or file path if using SQLite)
DB_NAME="your_database_name"

# Credentials
DB_USER="your_database_username"
DB_PASSWORD="your_database_password"

# SSL Mode (Required for many cloud hosts: 'require', 'prefer', 'disable')
# DB_SSLMODE="require"

# Driver (Only for MS SQL / Azure SQL)
DB_DRIVER="ODBC+Driver+17+for+SQL+Server"

# Extra URL parameters (Optional)
# DB_EXTRA_PARAMS="charset=utf8mb4"
